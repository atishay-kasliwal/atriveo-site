{
  "name": "atriveo-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "sync:github": "node scripts/sync-github.mjs",
    "build": "npm run sync:github && astro build && npm run audit:seo",
    "audit:seo": "node scripts/audit-seo.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "build:medscan": "astro build --root ./medscan",
    "check:medscan": "astro check --root ./medscan",
    "deploy:medscan": "npm run build:medscan && wrangler deploy --config medscan/wrangler.toml",
    "test:building": "node --test tests/building/*.test.mjs",
    "review:building": "node scripts/building-review.mjs",
    "posters:building": "node scripts/building-posters.mjs",
    "dev:building": "wrangler dev --local --ip 127.0.0.1 --port 4455",
    "check:building-worker": "wrangler deploy --dry-run --outdir /tmp/atriveo-building-worker-check && node scripts/building-verify-worker.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@power-seo/audit": "^1.0.19",
    "@power-seo/meta": "^1.0.19",
    "@power-seo/schema": "^1.0.19",
    "astro": "^7.2.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260825.1",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.125.0"
  }
}
