---
import type { Project } from "../data/projects";
type Props = { project: Project; large?: boolean; };
const { project, large = false } = Astro.props;
---
<div class:list={["project-visual", "night-project-art", large && "is-large"]} aria-hidden="true">
  <div class="night-art-window"><span></span><span></span><span></span><span></span></div>
  <span class="visual-index">Atriveo / {project.category}</span>
  <strong class="night-art-monogram">{project.monogram}</strong>
  <span class="visual-state">{project.shortName}</span>
</div>
