---
import type { Project } from "../data/projects";
import ProjectVisual from "./ProjectVisual.astro";

type Props = {
  project: Project;
  featured?: boolean;
};

const { project, featured = false } = Astro.props;
const liveLink = project.links.find((link) => link.kind === "live");
const sourceLink = project.links.find((link) => link.kind === "source");
---

<article
  class:list={["project-card", featured && "is-featured"]}
  data-project-card
  data-category={project.category}
  data-stage={project.stage}
  data-search={`${project.name} ${project.shortDescription} ${project.category} ${project.technologies.join(" ")}`.toLowerCase()}
>
  <ProjectVisual project={project} large={featured} />
  <div class="project-card-body">
    <div class="project-card-meta">
      <span>{project.category}</span>
      <span class:list={["status-dot", project.stage === "Live" && "is-live"]}>{project.stage}</span>
    </div>
    <h3><a href={`/projects/${project.slug}`}>{project.name}</a></h3>
    <p>{project.shortDescription}</p>
    <div class="project-tags" aria-label="Technologies">
      {project.technologies.slice(0, featured ? 4 : 3).map((technology) => <span>{technology}</span>)}
    </div>
    <div class="project-actions">
      {liveLink && <a class="text-link primary-link" href={liveLink.href}>Open live <span aria-hidden="true">↗</span></a>}
      {sourceLink && <a class="text-link" href={sourceLink.href}>Source <span aria-hidden="true">↗</span></a>}
      {!liveLink && !sourceLink && <a class="text-link" href={`/projects/${project.slug}`}>Read details <span aria-hidden="true">→</span></a>}
    </div>
  </div>
</article>
