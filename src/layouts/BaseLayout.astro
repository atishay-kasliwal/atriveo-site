---
import "../styles/global.css";
import { createAtriveoHead, createAtriveoJsonLd, type SchemaObject } from "../lib/seo";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  pageSchemas?: SchemaObject[];
};

const {
  title = "Atriveo | A Public Hub for Everything Being Built",
  description =
    "Atriveo is the public hub for everything Atishay Kasliwal is building: live products, open-source experiments, public activity, and the work connecting them.",
  canonicalPath = Astro.url.pathname,
  noindex = false,
  pageSchemas = [],
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site || "https://atriveo.com");
const seoHead = createAtriveoHead({ title, description, canonical: canonical.toString(), noindex });
const structuredData = createAtriveoJsonLd(pageSchemas);
const path = Astro.url.pathname;
const navItems = [
  { href: "/", label: "Hub" },
  { href: "/projects", label: "Projects" },
  { href: "/open-source", label: "Open source" },
  { href: "/about", label: "About" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Fragment set:html={seoHead} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <header class="site-header">
        <a class="brand-lockup" href="/" aria-label="Atriveo home">
          <span class="brand-mark" aria-hidden="true">A<i></i></span>
          <span class="brand-copy"><strong>Atriveo</strong><small>Builder hub</small></span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a class:list={["nav-link", isActive(item.href) && "is-active"]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <a class="header-action" href="/projects">
          Browse builds
          <span class="action-icon" aria-hidden="true">
            <svg viewBox="0 0 16 16"><path d="M3.5 8h9M9 4.5 12.5 8 9 11.5" /></svg>
          </span>
        </a>
        <details class="mobile-nav">
          <summary aria-label="Open navigation">
            <span>Menu</span>
            <i aria-hidden="true"></i>
          </summary>
          <div class="mobile-nav-panel">
            <nav aria-label="Mobile navigation">
              {navItems.map((item, index) => (
                <a class:list={["mobile-nav-link", isActive(item.href) && "is-active"]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                  <small>{String(index + 1).padStart(2, "0")}</small>
                  <span>{item.label}</span>
                  <i aria-hidden="true">→</i>
                </a>
              ))}
            </nav>
            <a class="mobile-nav-action" href="/projects">Browse all builds <span aria-hidden="true">→</span></a>
          </div>
        </details>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-wordmark">
          <a class="wordmark" href="/">Atriveo<span>.</span></a>
          <p>Focused tools for complicated work.</p>
        </div>
        <div class="footer-links">
          <div>
            <span class="footer-label">Explore</span>
            <a href="/projects">Projects</a>
            <a href="/open-source">Open source</a>
            <a href="/about">About</a>
          </div>
          <div>
            <span class="footer-label">Builds</span>
            <a href="/projects">All projects</a>
            <a href="https://github.com/atishay-kasliwal">GitHub</a>
          </div>
          <div>
            <span class="footer-label">Legal</span>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Atriveo</span>
          <span>New York · Built on the open web</span>
        </div>
      </footer>
    </div>
  </body>
</html>
