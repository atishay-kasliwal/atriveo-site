---
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
};

const {
  title = "Atriveo — Useful systems, built in public",
  description =
    "Explore Atriveo products for careers, research, creativity, health, and personal intelligence.",
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site || "https://atriveo.com");
const path = Astro.url.pathname;
const navItems = [
  { href: "/projects", label: "Projects" },
  { href: "/open-source", label: "Open source" },
  { href: "/about", label: "About" },
];
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Atriveo",
  url: "https://atriveo.com",
  sameAs: ["https://github.com/atishay-kasliwal"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7fb" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Atriveo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Atriveo home">Atriveo<span>.</span></a>
        <nav aria-label="Primary navigation">
          {navItems.map((item) => (
            <a class:list={["nav-link", path.startsWith(item.href) && "is-active"]} href={item.href}>
              {item.label}
            </a>
          ))}
        </nav>
        <a class="header-action" href="https://tracker.atriveo.com">
          Open Tracker
          <span aria-hidden="true">↗</span>
        </a>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-wordmark">
          <a class="wordmark" href="/">Atriveo<span>.</span></a>
          <p>Focused tools for complicated work.</p>
        </div>
        <div class="footer-links">
          <div>
            <span class="footer-label">Explore</span>
            <a href="/projects">Projects</a>
            <a href="/open-source">Open source</a>
            <a href="/about">About</a>
          </div>
          <div>
            <span class="footer-label">Elsewhere</span>
            <a href="https://tracker.atriveo.com">Tracker</a>
            <a href="https://github.com/atishay-kasliwal">GitHub</a>
          </div>
          <div>
            <span class="footer-label">Legal</span>
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Atriveo</span>
          <span>New York · Built on the open web</span>
        </div>
      </footer>
    </div>
  </body>
</html>
