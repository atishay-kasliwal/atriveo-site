---
import BaseLayout from "../layouts/BaseLayout.astro";
import LivingBuilding from "../components/LivingBuilding.astro";
import ProjectDirectory from "../components/ProjectDirectory.astro";
import { projects, categories } from '../data/projects';
const selected = ['cortex', 'applications'].map(slug => projects.find(p => p.slug === slug)!);
---
<BaseLayout immersiveHeader>
  <LivingBuilding />
  <section class="night-introduction section-shell" aria-labelledby="intro-heading">
    <div class="night-section-label"><span class="night-window" aria-hidden="true"></span>Atriveo, beyond the windows</div>
    <div class="night-intro-grid">
      <h2 id="intro-heading">Different ideas.<br />One place to <span>build.</span></h2>
      <div class="night-intro-copy"><p>Atriveo is the home for everything I’m building. Tools for finding work, making sense of information, and following an idea somewhere useful.</p><p>Some are live. Some are open source. All start with something that could work a little better.</p><a class="night-inline-link" href="/about/">Meet the builder <span aria-hidden="true">↗</span></a>
      <dl class="night-counts"><div><dt>{String(projects.length).padStart(2, '0')}</dt><dd>builds under one roof</dd></div><div><dt>{String(categories.length).padStart(2, '0')}</dt><dd>areas of curiosity</dd></div></dl></div>
    </div>
  </section>
  <section class="night-selected section-shell" aria-labelledby="selected-heading">
    <div class="night-section-heading"><div><span class="night-section-label">A closer look</span><h2 id="selected-heading">A few lights on.</h2></div><a class="night-inline-link" href="/projects/">Explore all builds <span aria-hidden="true">↗</span></a></div>
    <div class="night-selected-grid">
      {selected.map((project, index) => <article class="night-feature">
        <a class="night-feature-image" href={`/projects/${project.slug}/`} aria-label={`Explore ${project.name}`}>
          {project.media?.images[0] && <img src={project.media.images[0].small[0]} width={project.media.images[0].width} height={project.media.images[0].height} alt={project.media.images[0].alt} loading="lazy" decoding="async" />}
          <span class="night-feature-open" aria-hidden="true">↗</span>
        </a>
        <div class="night-feature-meta"><span>{String(index + 1).padStart(2,'0')} / {project.category}</span><span class="night-build-state is-live"><i></i>{project.stage}</span></div>
        <h3><a href={`/projects/${project.slug}/`}>{project.name}</a></h3><p>{project.shortDescription}</p>
      </article>)}
    </div>
  </section>
  <section class="night-catalog section-shell" id="builds" aria-labelledby="builds-heading">
    <div class="night-section-heading"><div><span class="night-section-label">The complete collection</span><h2 id="builds-heading">Find your way in.</h2></div><p>Different problems. The same curiosity.<br />Pick something that speaks to yours.</p></div>
    <ProjectDirectory />
  </section>
  <section class="night-invitation section-shell" aria-labelledby="invitation-heading">
    <span class="night-section-label"><span class="night-window" aria-hidden="true"></span>There’s room for you here</span>
    <h2 id="invitation-heading">Good things grow<br />with the <span>door open.</span></h2>
    <div class="night-invitation-bottom"><p>Read the code. Try a build. Bring a different perspective.<br />This is a place to make useful things, together.</p><a class="button button-primary" href="/open-source/">Come build with us <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
